---
import BookingPage from "@components/BookingPage";
import BaseLayout from "@layouts/BaseLayout.astro";
import { siteConfig } from "@data/site";
import { breadcrumbSchema, serviceSchema } from "@lib/seo";

const schemas = [
  serviceSchema(
    "Online junk removal booking",
    "Start a junk removal pickup request through our third-party booking partner.",
  ),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Book", path: "/book/" },
  ]),
];
---

<BaseLayout
  title={`Book Junk Removal Online | ${siteConfig.name}`}
  description="Enter your pickup details and start booking junk removal online."
  canonicalPath="/book/"
  schemas={schemas}
  hideChrome
  noindex
>
  <BookingPage client:load />
</BaseLayout>
