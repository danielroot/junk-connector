---
import BaseLayout from "@layouts/BaseLayout.astro";
import { siteConfig } from "@data/site";
import { breadcrumbSchema, serviceSchema } from "@lib/seo";

const schemas = [
  serviceSchema(
    "Online junk removal booking",
    "Start a junk removal pickup request through our third-party booking partner.",
  ),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Book", path: "/book/" },
  ]),
];
---

<BaseLayout
  title={`Book Junk Removal Online | ${siteConfig.name}`}
  description="Enter your pickup details and start booking junk removal online."
  canonicalPath="/book/"
  schemas={schemas}
  hideChrome
  noindex
>
  <section class="booking-page" role="region" aria-label="Booking page">
    <header class="booking-page-bar">
      <a class="booking-back-link" href="/" data-booking-back-link>
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        Back to guide
      </a>
    </header>

    <div class="booking-embed-shell" aria-label="Booking form">
      <div class="booking-loading" role="status" aria-live="polite" data-booking-loading>
        <span class="booking-loading-spinner" aria-hidden="true"></span>
        <span class="booking-loading-title">Loading booking form</span>
        <span class="booking-loading-copy">
          Checking availability with our booking partner.
        </span>
      </div>
      <div
        class="quote-form-shell"
        id="quote-form"
        data-attribution-source={siteConfig.bookingPartnerAttributionSource}
        style="overflow: auto; -webkit-overflow-scrolling: touch;"
      ></div>
      <div class="booking-partner-prompt-mask" data-partner-prompt-mask aria-hidden="true"></div>
      <noscript>
        <p class="booking-error">JavaScript is required to load the booking form.</p>
      </noscript>
    </div>
  </section>

  <script
    is:inline
    src={siteConfig.bookingPartnerScriptUrl}
  ></script>
  <script is:inline>
    (() => {
      const sanitizeBackPath = (value) => {
        if (!value || !value.startsWith("/") || value.startsWith("//")) return "";
        return value;
      };

      const params = new URLSearchParams(window.location.search);
      const backLink = document.querySelector("[data-booking-back-link]");
      const partnerPromptMask = document.querySelector("[data-partner-prompt-mask]");
      let initialIframeHeight = null;
      let maskResizeReadyAt = 0;
      let backPath = sanitizeBackPath(params.get("back"));

      if (!backPath && document.referrer) {
        try {
          const referrer = new URL(document.referrer);
          if (referrer.origin === window.location.origin) {
            backPath = `${referrer.pathname}${referrer.search}${referrer.hash}`;
          }
        } catch {
          backPath = "";
        }
      }

      if (backLink) backLink.setAttribute("href", backPath || "/");

      document.addEventListener("DOMContentLoaded", () => {
        const iframe = document.querySelector('#quote-form iframe[data-resizable="true"]');
        if (!iframe) return;
        iframe.title = "Booking form";
        iframe.classList.add("booking-iframe");

        const revealBookingForm = () => {
          iframe.classList.add("is-loaded");
          partnerPromptMask?.classList.add("is-active");
          maskResizeReadyAt = performance.now() + 2000;
          const loading = document.querySelector("[data-booking-loading]");
          if (!loading) return;
          loading.classList.add("is-hidden");
          loading.setAttribute("aria-hidden", "true");
        };

        iframe.addEventListener("load", revealBookingForm, { once: true });
      });

      window.addEventListener("message", (event) => {
        if (event.origin !== "https://order.goloadup.com" || !event.data) return;

        if (event.data.type === "resizeIframe") {
          const nextHeight = Number.parseInt(event.data.height, 10);
          if (!Number.isFinite(nextHeight)) return;
          if (!maskResizeReadyAt || performance.now() < maskResizeReadyAt) {
            initialIframeHeight = nextHeight;
          } else if (
            initialIframeHeight !== null &&
            Math.abs(nextHeight - initialIframeHeight) > 60
          ) {
            partnerPromptMask?.classList.remove("is-active");
          }
        }

        if (["scrollToPosition", "completed_order", "goToPath"].includes(event.data.type)) {
          partnerPromptMask?.classList.remove("is-active");
        }
      });
    })();
  </script>
</BaseLayout>
