---
import BookingModule from "@components/BookingModule";
import FAQAccordion from "@components/FAQAccordion";
import BaseLayout from "@layouts/BaseLayout.astro";
import { approvedRegions } from "@data/regions";
import { bookingPagePath } from "@lib/booking";
import {
  breadcrumbSchema,
  faqSchema,
  regionPath,
  serviceSchema,
} from "@lib/seo";

export function getStaticPaths() {
  return approvedRegions.map((region) => ({
    params: {
      state: region.stateCode,
      city: region.slug,
    },
    props: { region },
  }));
}

const { region } = Astro.props;
const canonicalPath = regionPath(region);
const schemas = [
  serviceSchema(region.title, region.description, `${region.city}, ${region.state}`),
  faqSchema(region.faqs),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Locations", path: "/#locations" },
    { name: `${region.city}, ${region.state}`, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={`${region.title} | Junk Connector`}
  description={region.description}
  canonicalPath={canonicalPath}
  image={region.heroImage}
  schemas={schemas}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Sponsored booking guide</p>
      <h1>{region.title}</h1>
      <p class="lede">{region.description}</p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href={bookingPagePath({
            campaign: region.bookingTracking.campaign,
            region: region.bookingTracking.region,
            back: canonicalPath,
          })}
        >
          <span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
          Start booking
        </a>
        <a class="button button-secondary" href="#local-notes">
          <span class="material-symbols-rounded" aria-hidden="true">info</span>
          Local notes
        </a>
      </div>
    </div>
    <figure class="hero-media">
      <img src={region.heroImage} alt={region.imageAlt} width="1392" height="768" loading="eager" />
    </figure>
  </section>

  <section class="section" id="local-notes">
    <div class="section-inner">
      <div class="section-header">
        <p class="eyebrow">Service-area details</p>
        <h2>Before you book in {region.city}</h2>
        <p class="lede">{region.serviceAreaNote}</p>
      </div>
      <div class="meta-grid">
        {
          region.localSignals.map((signal) => (
            <article class="card">
              <span class="card-icon material-symbols-rounded" aria-hidden="true">near_me</span>
              <p>{signal}</p>
            </article>
          ))
        }
      </div>
      <ul class="pill-list" aria-label="Accepted junk categories">
        {
          region.acceptedCategories.map((category) => (
            <li>
              <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
              {category}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-inner">
      <div class="section-header">
        <p class="eyebrow">Common jobs</p>
        <h2>Useful booking scenarios</h2>
      </div>
      <div class="card-grid">
        {
          region.commonScenarios.map((scenario) => (
            <article class="card">
              <span class="card-icon material-symbols-rounded" aria-hidden="true">task_alt</span>
              <p>{scenario}</p>
            </article>
          ))
        }
      </div>
      <p class="notice" style="margin-top: 1.5rem;">{region.donationRecyclingNote}</p>
    </div>
  </section>

  <section class="section" id="booking">
    <div class="section-inner">
      <BookingModule
        client:load
        title={`Start a ${region.city} junk removal booking`}
        campaign={region.bookingTracking.campaign}
        region={region.bookingTracking.region}
        back={`${canonicalPath}#booking`}
      />
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-inner">
      <div class="section-header">
        <p class="eyebrow">Questions</p>
        <h2>{region.city} junk removal FAQ</h2>
      </div>
      <FAQAccordion faqs={region.faqs} client:load />
    </div>
  </section>
</BaseLayout>
