---
import BookingModule from "@components/BookingModule.astro";
import LinkedCard from "@components/LinkedCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { approvedRegions } from "@data/regions";
import { junkItems } from "@data/items";
import { siteConfig } from "@data/site";
import { bookingPagePath } from "@lib/booking";
import {
  breadcrumbSchema,
  itemPath,
  regionPath,
  serviceSchema,
  withBasePath,
} from "@lib/seo";

const schemas = [
  serviceSchema(
    "Online junk removal booking",
    "Find local junk removal information and start booking a pickup online.",
  ),
  breadcrumbSchema([{ name: "Home", path: "/" }]),
];
---

<BaseLayout
  title={siteConfig.defaultTitle}
  description={siteConfig.defaultDescription}
  canonicalPath="/"
  schemas={schemas}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Junk removal booking, region by region</p>
      <h1>Book junk removal online</h1>
      <p class="lede">
        Find your service area, review helpful preparation tips, and start booking a junk removal
        pickup online.
      </p>
      <div class="hero-actions">
        <a class="button button-secondary" href="#locations">
          <span class="material-symbols-rounded" aria-hidden="true">location_on</span>
          View locations
        </a>
        <a class="button button-primary" href={bookingPagePath({ campaign: "homepage", back: "/" })}>
          Get a Free Quote
          <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
    <figure class="hero-media">
      <img
        src={siteConfig.defaultImage}
        alt="Junk removal themed characters holding furniture and bagged items"
        width="1200"
        height="655"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <section class="section section-muted" id="locations">
    <div class="section-inner">
      <div class="section-header">
        <h2>Find junk removal near you</h2>
        <p class="lede">
          Choose your city to explore local pickup information, helpful preparation tips, and
          online booking options.
        </p>
      </div>
      <div class="card-grid" style="margin-top: 1.5rem;">
        {
          approvedRegions.map((region) => (
            <LinkedCard
              href={withBasePath(regionPath(region))}
              title={`${region.city}, ${region.state}`}
              description={region.serviceAreaNote}
              icon="location_on"
              linkLabel="View booking guide"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="items">
    <div class="section-inner">
      <div class="section-header">
        <p class="eyebrow">Book by item</p>
        <h2>Common junk removal jobs</h2>
        <p class="lede">
          Learn what to prepare before booking removal for mattresses, furniture, and appliances.
        </p>
      </div>
      <div class="card-grid">
        {
          junkItems.map((item) => (
            <LinkedCard
              href={withBasePath(itemPath(item))}
              title={item.name}
              description={item.description}
              icon={
                item.slug === "mattress-removal"
                  ? "bed"
                  : item.slug === "appliance-removal"
                    ? "kitchen"
                    : "chair"
              }
              linkLabel="View prep notes"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-muted" id="booking">
    <div class="section-inner">
      <BookingModule campaign="homepage" back="/#booking" />
    </div>
  </section>
</BaseLayout>
