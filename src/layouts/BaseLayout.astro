---
import { siteConfig } from "@data/site";
import { absoluteUrl, jsonLd, organizationSchema, websiteSchema } from "@lib/seo";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  schemas?: unknown[];
  hideChrome?: boolean;
};

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonicalPath = "/",
  image = siteConfig.defaultImage,
  schemas = [],
  hideChrome = false,
} = Astro.props;
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    {allSchemas.map((schema) => <script type="application/ld+json" set:html={jsonLd(schema)} />)}
    <script src="/scripts/analytics-events.js" defer></script>
  </head>
  <body>
    {
      !hideChrome && (
        <>
          <a class="skip-link" href="#main">Skip to content</a>
          <header class="site-header">
            <a class="brand" href="/" aria-label="Junk Connector home">
              <span class="brand-mark">JC</span>
              <span>Junk Connector</span>
            </a>
            <nav aria-label="Primary navigation">
              <a href="/#locations">
                <span class="material-symbols-rounded" aria-hidden="true">location_on</span>
                <span>Locations</span>
              </a>
              <a href="/#items">
                <span class="material-symbols-rounded" aria-hidden="true">inventory_2</span>
                <span>Items</span>
              </a>
              <a href="/faq/">
                <span class="material-symbols-rounded" aria-hidden="true">help</span>
                <span>FAQ</span>
              </a>
              <a href="/book/?campaign=site-nav">
                <span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
                <span>Book</span>
              </a>
            </nav>
          </header>
        </>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !hideChrome && (
        <footer class="site-footer">
          <p>{siteConfig.affiliateDisclosure}</p>
          <p>
            Junk Connector is a referral publisher, not a hauling company. Service, pricing, and
            availability are controlled by the sponsored booking partner.
          </p>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #18201f;
    --muted: #5a6863;
    --line: #d9e3df;
    --surface: #f7faf8;
    --booking-surface: #f0f0f0;
    --paper: #ffffff;
    --primary: #0f766e;
    --primary-dark: #0b4f4a;
    --accent: #f5b84b;
    --accent-soft: #fff3cf;
    --danger-soft: #fff0ed;
    --max: 1160px;
    font-family: Montserrat, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  .material-symbols-rounded {
    display: inline-block;
    font-family: "Material Symbols Rounded";
    font-size: 1.25em;
    font-style: normal;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    direction: ltr;
    font-feature-settings: "liga";
    -webkit-font-feature-settings: "liga";
    -webkit-font-smoothing: antialiased;
    vertical-align: -0.18em;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 20;
    background: var(--ink);
    color: white;
    padding: 0.6rem 0.8rem;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(12px);
  }

  .brand,
  .site-header nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .brand {
    font-weight: 800;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: var(--primary);
    color: white;
    font-size: 0.9rem;
  }

  .site-header nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header nav .material-symbols-rounded {
    font-size: 1.15rem;
  }

  .site-header nav a:hover {
    color: var(--primary-dark);
  }

  .hero,
  .section,
  .site-footer {
    padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.82fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    min-height: calc(100vh - 74px);
    background: linear-gradient(120deg, #f8fbfa 0%, #ffffff 56%, #fff7df 100%);
  }

  .hero-compact {
    min-height: min(720px, calc(100vh - 74px));
  }

  .hero-copy,
  .section-inner,
  .site-footer {
    max-width: var(--max);
    margin: 0 auto;
  }

  .hero-copy {
    width: 100%;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--primary-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 7.5vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .lede {
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.18rem;
  }

  .hero-actions,
  .booking-actions,
  .card-grid,
  .pill-list,
  .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.8rem;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
  }

  .button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .button .material-symbols-rounded {
    font-size: 1.25rem;
  }

  .button-primary {
    background: var(--primary);
    color: white;
  }

  .button-primary:hover {
    background: var(--primary-dark);
  }

  .button-secondary {
    background: white;
    border-color: var(--line);
    color: var(--ink);
  }

  .hero-media {
    align-self: stretch;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #edf4f1;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section {
    border-top: 1px solid var(--line);
  }

  .section-muted {
    background: var(--surface);
  }

  .section-header {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card,
  .booking-module,
  .faq-item,
  .notice,
  .location-selector {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: white;
  }

  .card {
    padding: 1.25rem;
  }

  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .card p {
    color: var(--muted);
  }

  .card-icon {
    margin-bottom: 0.75rem;
    color: var(--primary-dark);
    font-size: 1.8rem;
  }

  .card a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 800;
    color: var(--primary-dark);
    text-decoration-thickness: 2px;
  }

  .pill-list {
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .pill-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    background: white;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .pill-list .material-symbols-rounded {
    color: var(--primary);
    font-size: 1rem;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .notice {
    background: var(--accent-soft);
    border-color: #efd288;
    padding: 1rem;
  }

  .booking-module {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .booking-copy p {
    max-width: 70ch;
  }

  .booking-disclosure,
  .site-footer p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .booking-page {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--booking-surface);
  }

  .booking-page-bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    background: var(--booking-surface);
  }

  .booking-back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 0 0 auto;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    background: var(--booking-surface);
    color: var(--ink);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .booking-embed-shell {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    padding: 0;
    background: var(--booking-surface);
    border: 0;
    margin: 0;
  }

  #quote-form,
  .quote-form-shell {
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .booking-iframe {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .booking-iframe.is-loaded {
    opacity: 1;
  }

  .booking-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.7rem;
    padding: 2rem;
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.62), transparent),
      var(--booking-surface);
    background-size: 220% 100%, auto;
    color: var(--ink);
    text-align: center;
    animation: booking-loading-sheen 1.6s ease-in-out infinite;
  }

  .booking-loading-spinner {
    width: 2.25rem;
    height: 2.25rem;
    border: 3px solid #d6d6d6;
    border-top-color: var(--primary);
    border-radius: 999px;
    animation: booking-loading-spin 900ms linear infinite;
  }

  .booking-loading-title {
    font-size: 1.1rem;
    font-weight: 800;
  }

  .booking-loading-copy {
    max-width: 28rem;
    color: var(--muted);
  }

  @keyframes booking-loading-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes booking-loading-sheen {
    0% {
      background-position: 180% 0, 0 0;
    }

    100% {
      background-position: -80% 0, 0 0;
    }
  }

  .booking-error {
    grid-column: 1 / -1;
    margin: 0;
    color: #9b2f1f;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-iframe,
    .booking-loading,
    .booking-loading-spinner {
      animation: none;
      transition: none;
    }
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  .faq-group-list {
    display: grid;
    gap: 2rem;
  }

  .faq-group {
    display: grid;
    gap: 1rem;
  }

  .faq-group-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-group-heading h3,
  .faq-group-heading a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .faq-group-heading h3 {
    margin: 0;
  }

  .faq-group-heading a {
    color: var(--primary-dark);
    font-weight: 800;
    text-decoration-thickness: 2px;
    white-space: nowrap;
  }

  .faq-item {
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 0;
    background: white;
    padding: 1rem;
    color: var(--ink);
    font: inherit;
    font-weight: 800;
    text-align: left;
    cursor: pointer;
  }

  .faq-answer {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--muted);
  }

  .location-selector {
    max-width: 560px;
    padding: 1rem;
  }

  .location-selector label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .location-selector-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
  }

  select {
    width: 100%;
    min-height: 2.8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0 0.7rem;
    background: white;
    color: var(--ink);
    font: inherit;
  }

  .site-footer {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .site-header {
      position: static;
      align-items: flex-start;
      flex-direction: column;
    }

    .hero,
    .booking-module {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .hero-media {
      min-height: 300px;
    }

    .card-grid,
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-header nav,
    .location-selector-row,
    .faq-group-heading {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr;
    }

    .booking-page-bar {
      align-items: flex-start;
      flex-direction: column;
    }

    .booking-back-link {
      width: 100%;
    }

    h1 {
      font-size: 3.2rem;
    }
  }
</style>
