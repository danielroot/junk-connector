---
import { bookingPagePath } from "@lib/booking";
import { siteConfig } from "@data/site";

type Props = {
  title?: string;
  description?: string;
  campaign: string;
  region?: string;
  item?: string;
  back?: string;
};

const {
  title = "Start your junk removal booking",
  description = "Enter your details with the sponsored booking partner to confirm availability, pricing, and pickup options.",
  campaign,
  region,
  item,
  back,
} = Astro.props;

const href = bookingPagePath({ campaign, region, item, back });
---

<a
  class="booking-module booking-module-link"
  href={href}
  aria-labelledby={`booking-heading-${campaign}`}
  data-analytics-event="booking_click"
>
  <div class="booking-copy">
    <p class="eyebrow">Sponsored booking partner</p>
    <h2 id={`booking-heading-${campaign}`}>{title}</h2>
    <p>{description}</p>
    <p class="booking-disclosure">
      Booking, pricing, service availability, and pickup details are handled by the partner.
    </p>
  </div>

  <span class="booking-module-art" aria-hidden="true">
    <img
      src={siteConfig.defaultImage}
      alt=""
      width="1200"
      height="655"
      loading="lazy"
      decoding="async"
    />
  </span>

  <div class="booking-actions">
    <span class="button button-primary">Book Now</span>
  </div>
</a>
