---
import { bookingPagePath } from "@lib/booking";

type Props = {
  title?: string;
  description?: string;
  campaign: string;
  region?: string;
  item?: string;
  back?: string;
};

const {
  title = "Start your junk removal booking",
  description = "Enter your details to check local availability, pricing, and pickup options.",
  campaign,
  region,
  item,
  back,
} = Astro.props;

const href = bookingPagePath({ campaign, region, item, back });
---

<a
  class="booking-module booking-module-link"
  href={href}
  aria-labelledby={`booking-heading-${campaign}`}
  data-analytics-event="booking_click"
>
  <div class="booking-copy">
    <h2 id={`booking-heading-${campaign}`}>{title}</h2>
    <p>{description}</p>
    <p class="booking-disclosure">
      Booking, pricing, availability, and pickup service are provided by our third-party partner.
    </p>
  </div>

  <div class="booking-actions">
    <span class="button button-primary">Book Now</span>
  </div>
</a>
